# Public URLs / feature flags
NEXT_PUBLIC_TG_MOCK=1
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3010

# WalletConnect v2 project id from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional custom RPC endpoints (leave empty to use public defaults)
NEXT_PUBLIC_MAINNET_RPC=
NEXT_PUBLIC_POLYGON_RPC=
NEXT_PUBLIC_ARBITRUM_RPC=
NEXT_PUBLIC_BASE_RPC=

# AML provider configuration
AML_PROVIDER=tonapi
AML_TONAPI_KEY=
AML_TRM_KEY=
AML_HAPI_KEY=
